                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:db0b3473-ac6c-52ba-8d58-21770ad5d14f">
                  <SHORT-NAME>SoAdPduRoute</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Describes the path of a PDU from the PDU Router to the socket in the TCP/IP stack for transmission.</L-2>
                  </DESC>
