                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:bdb010d2-a51d-5eca-b2db-cf0231f3e4dd">
                      <SHORT-NAME>RteNvRamAllocation</SHORT-NAME>
