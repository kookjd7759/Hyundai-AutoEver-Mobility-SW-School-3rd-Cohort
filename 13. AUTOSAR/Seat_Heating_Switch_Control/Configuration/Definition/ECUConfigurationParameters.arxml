                        </ECUC-REFERENCE-DEF>
                        <ECUC-REFERENCE-DEF UUID="ECUC:12a13260-51e1-55fd-83ba-c07fdf38d1d7">
                          <SHORT-NAME>ComMUserPerPnc</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Reference to the ComMUsers that correspond to this PNC.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">ImplementationType: COMM_UserHandleType</L-1>
                            </P>
                          </INTRODUCTION>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
