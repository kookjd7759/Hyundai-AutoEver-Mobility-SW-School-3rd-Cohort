                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:0d9c523c-3ece-57aa-b2ad-2f68419e8511">
                      <SHORT-NAME>CanIfPublicVersionInfoApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Enables and disables the API  for reading the version information about the CAN Interface.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">True: Enabled
                                        False: Disabled</L-1>
                        </P>
                      </INTRODUCTION>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
