                                  <SHORT-NAME>FRNM_PDU_SCHEDULE_VARIANT_5</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:6fff7aac-bb9f-56cc-7403-2db6e49b7510">
                                  <SHORT-NAME>FRNM_PDU_SCHEDULE_VARIANT_6</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:2ddf68ed-d95a-5346-6fa5-ca2cbd4dabb9">
