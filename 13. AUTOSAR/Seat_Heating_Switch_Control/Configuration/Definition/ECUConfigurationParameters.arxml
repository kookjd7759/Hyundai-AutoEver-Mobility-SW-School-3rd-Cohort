                                  <SHORT-NAME>NEW_IS_WITHIN</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:d4657bc5-abcd-5121-2fb1-5974f8accac3">
