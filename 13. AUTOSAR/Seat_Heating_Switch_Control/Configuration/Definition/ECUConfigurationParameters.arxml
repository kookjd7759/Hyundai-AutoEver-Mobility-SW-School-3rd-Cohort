                              <SHORT-NAME>XcpRxPduId</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">ID of the PDU that will be received via a Xcp_&lt;module>RxIndication.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <IMPLEMENTATION-CONFIG-CLASSES>
