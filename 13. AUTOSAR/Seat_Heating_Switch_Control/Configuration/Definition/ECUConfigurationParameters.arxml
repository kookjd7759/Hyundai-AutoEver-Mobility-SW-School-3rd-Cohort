                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9f920c69-c570-5aa9-9ab1-a216fe2a1faa">
                              <SHORT-NAME>XcpTxPduId</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">The PDU identifier, which has to be used by the lower layer BSW module for TxConfirmations or TriggerTransmits.</L-2>
