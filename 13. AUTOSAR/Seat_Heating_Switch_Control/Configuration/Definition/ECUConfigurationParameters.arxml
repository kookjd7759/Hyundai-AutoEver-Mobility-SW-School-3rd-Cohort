                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:1934cc0d-4793-5d66-6a06-63b5c2fb1d77">
                          <SHORT-NAME>MEMIF_MODE_FAST</SHORT-NAME>
