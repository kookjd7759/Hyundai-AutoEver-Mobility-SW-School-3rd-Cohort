                        <P>
                          <L-1 L="EN">TRUE: TCP/IP Stack supports AUTOSAR callback API
                                        FALSE: TCP/IP Stack supports only BSD Sockets.</L-1>
                        </P>
                      </INTRODUCTION>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
