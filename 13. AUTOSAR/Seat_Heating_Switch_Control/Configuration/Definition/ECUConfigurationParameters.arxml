                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <MAX>32767</MAX>
                                      <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:aa2d713a-ec74-5c4c-93a9-bd83b0c107b8">
                                      <SHORT-NAME>DemDebounceCounterJumpDown</SHORT-NAME>
                                      <DESC>
