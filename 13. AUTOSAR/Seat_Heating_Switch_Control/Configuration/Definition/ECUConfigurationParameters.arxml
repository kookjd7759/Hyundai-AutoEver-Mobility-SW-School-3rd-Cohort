                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:a82678fb-fc06-5749-8c1f-39a73c6d4dbd">
                          <SHORT-NAME>XcpEventChannelType</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This configuration parameter indicates what kind of DAQ list can be allocated to this event channel.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
