                              <SHORT-NAME>RamTstNumberOfTestedCells</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This is the initial value for a RAM variable, which can be changed by the function &quot;RamTst_ChangeNumberOfTestedCells&quot;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
