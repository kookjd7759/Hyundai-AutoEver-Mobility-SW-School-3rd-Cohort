                      </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                    </ECUC-FUNCTION-NAME-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:687f878a-ab78-587e-afd6-9cea1d16e990">
                      <SHORT-NAME>FrSMVersionInfoApi</SHORT-NAME>
