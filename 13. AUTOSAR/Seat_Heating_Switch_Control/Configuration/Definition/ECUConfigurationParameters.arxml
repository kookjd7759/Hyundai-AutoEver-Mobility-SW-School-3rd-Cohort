                          <MAX>65535</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:09954cb0-1956-5c20-a3ce-8ee76f5b30d6">
                      <SHORT-NAME>FiMInhibitionConfiguration</SHORT-NAME>
