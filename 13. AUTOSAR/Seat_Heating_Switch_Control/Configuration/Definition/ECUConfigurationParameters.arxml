                                  </ECUC-LINKER-SYMBOL-DEF-VARIANTS>
                                </ECUC-LINKER-SYMBOL-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4b26a816-11ca-53c5-829d-03684d1605a1">
                                  <SHORT-NAME>DbgASSize</SHORT-NAME>
                                  <DESC>
