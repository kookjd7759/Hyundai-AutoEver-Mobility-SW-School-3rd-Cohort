                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:22380264-b196-54e5-8202-0b65f9d4a6a6">
                      <SHORT-NAME>DltVfbTraceLogLevel</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">The log level of the log messages generated by the VFB-Trace.</L-2>
                      </DESC>
                      <INTRODUCTION>
