                                  <REFERENCES>
                                    <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:806494fe-5721-5700-9aff-afb9b96842f4">
                                      <SHORT-NAME>BswMLinSMChannelRef</SHORT-NAME>
                                      <DESC>
