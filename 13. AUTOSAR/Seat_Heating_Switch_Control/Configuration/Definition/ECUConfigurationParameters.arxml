                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:ab3d3623-1c3e-53f8-6bab-f797cb6d27d6">
                              <SHORT-NAME>LIN_SM</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:59a7fb27-4bdc-59b5-9d06-fe139cf39575">
