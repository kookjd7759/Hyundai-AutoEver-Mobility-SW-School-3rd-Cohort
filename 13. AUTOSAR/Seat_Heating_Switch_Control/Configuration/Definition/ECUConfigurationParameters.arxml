                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:36e196cd-aca7-5ede-be0c-36684a5d4382">
                      <SHORT-NAME>FrSMSyncLossErrorIndicationName</SHORT-NAME>
                      <DESC>
