                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f989ae03-b776-5ea2-a8d3-f2d0b872350f">
                              <SHORT-NAME>FrRange</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">FIFO Frame Id range acceptance criteria.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
