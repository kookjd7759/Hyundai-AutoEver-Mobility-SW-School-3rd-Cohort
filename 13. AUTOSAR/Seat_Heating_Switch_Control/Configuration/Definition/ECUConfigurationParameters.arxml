                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a4fbfe4d-0bfd-5740-9d2e-6422aa09a214">
                      <SHORT-NAME>NmGlobalProperties</SHORT-NAME>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
                      <PARAMETERS>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:74bd8ad8-344c-5ee9-8a81-42cc0daa4d55">
                          <SHORT-NAME>NmCycletimeMainFunction</SHORT-NAME>
                          <DESC>
