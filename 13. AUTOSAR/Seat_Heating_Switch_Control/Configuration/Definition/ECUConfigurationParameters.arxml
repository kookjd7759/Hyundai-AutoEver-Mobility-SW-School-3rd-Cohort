                            </ECUC-SYMBOLIC-NAME-REFERENCE-DEF>
                          </REFERENCES>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7d45be84-c819-5c3e-8708-f14e27a383bc">
