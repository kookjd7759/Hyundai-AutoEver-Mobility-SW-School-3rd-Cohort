                              <SHORT-NAME>FRARTP_OB</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:d2d18feb-09c6-5ecf-3005-8018be73dfd5">
                              <SHORT-NAME>FRARTP_TB</SHORT-NAME>
