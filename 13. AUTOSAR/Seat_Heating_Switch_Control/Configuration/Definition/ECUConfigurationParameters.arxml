                          <SHORT-NAME>RELATIVE_BYTE</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:f9fa9d23-2241-51f7-3963-93c3d007eabe">
                          <SHORT-NAME>RELATIVE_WORD</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4dbd1dc1-dc45-5901-5597-1e8cd65be6da">
