                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:55b15d51-51ba-563d-897e-aa9fdd385c07">
                          <SHORT-NAME>FrIfJobList</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container specifies a list of all FlexRay Jobs of the Cluster to be performed by FrIf_JobListExec_&lt;ClstIdx>().</L-2>
                          </DESC>
