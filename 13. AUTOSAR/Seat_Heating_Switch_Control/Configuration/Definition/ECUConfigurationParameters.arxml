                                    </ECUC-INTEGER-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2c4aba4f-9fc9-5572-a226-9562516ffac3">
                                      <SHORT-NAME>DemDebounceCounterPassedThreshold</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Defines the value of the internal fault detection counter, which indicates the passed status.</L-2>
                                      </DESC>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
